<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False"
        Width="530" Height="500" ResizeMode="NoResize"
        Background="#FFF2F2F2"
        WindowStartupLocation="CenterScreen"
        HorizontalContentAlignment="Center"
        Title="Criar Folhas (em Lote)">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top">
            Insira a lista de números e nomes de folhas neste formato:<LineBreak />
            <Bold>Dica:</Bold> você pode colar diretamente de uma planilha de Excell <LineBreak />
            <Bold>Modelo:</Bold>  número-da-folha TAB  nome-da-folha (ex.: A311 <Run FontSize="18" Text="⇥"/> NOME DA FOLHA)<LineBreak />
            Várias folhas com o mesmo nome podem ser listadas com intervalos de números:<LineBreak />
            <Bold>Intervalo de Números:</Bold>   ex.: A103--A106 ou A103::A106<LineBreak />
            <Bold>Lista de Números:</Bold>       ex.: A104,A105 ou A104;A105
        </TextBlock>
        <StackPanel DockPanel.Dock="Bottom">
            <WrapPanel>
                <RadioButton x:Name="sheet_cb" GroupName="sheetoptions"
                             Margin="10,10,0,5"
                             IsChecked="True">
                    Criar Folhas
                </RadioButton>
                <RadioButton x:Name="placeholder_cb"
                             GroupName="sheetoptions"
                             Margin="10,10,0,5"
                             IsChecked="False">
                    Criar Placeholders
                </RadioButton>
            </WrapPanel>
            <Button Content="Criar" Margin="0,10,0,0"
                    Height="24"
                    Click="create_sheets" Width="253"/>
        </StackPanel>
        <TextBox x:Name="sheets_tb"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 Margin="0 10 0 0"
                 FontFamily="Courier New" FontSize="14"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" Height="260"/>
    </DockPanel>
</Window>

