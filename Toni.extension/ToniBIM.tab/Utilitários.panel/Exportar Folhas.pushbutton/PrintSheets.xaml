<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Title="{DynamicResource Title}" Height="760" Width="1240" MinHeight="620" MinWidth="1000"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" HorizontalContentAlignment="Stretch"
        Background="#F5F7FA" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <system:String x:Key="Title">Exportar Folhas</system:String>
        <system:String x:Key="Model">Modelo</system:String>
        <system:String x:Key="LinkedPrefix">Vinculado: </system:String>
        <system:String x:Key="SheetIndex">Índice de folhas</system:String>
        <system:String x:Key="SheetPrinting">Exportacao de folhas</system:String>
        <system:String x:Key="SheetSearch">Buscar por número ou nome</system:String>
        <system:String x:Key="ExportPDF">Exportar PDF</system:String>
        <system:String x:Key="CombineIntoOnePDF">Combinar em um unico PDF</system:String>
        <system:String x:Key="ExportDWG">Exportar DWG</system:String>
        <system:String x:Key="NamingFormat">Nome dos arquivos</system:String>
        <system:String x:Key="EditFormats">Editar formatos</system:String>
        <system:String x:Key="Printer">Impressora</system:String>
        <system:String x:Key="PageSettings">Configuração de página</system:String>
        <system:String x:Key="DwgSettings">Configuração DWG</system:String>
        <system:String x:Key="IncompatibleWithPrinter">Incompativel com a impressora</system:String>
        <system:String x:Key="ListOfSheets">Folhas para exportar</system:String>
        <system:String x:Key="SetPrintSettings">Definir configuracoes de impressao</system:String>
        <system:String x:Key="ResetPrintSettings">Redefinir configuracoes</system:String>
        <system:String x:Key="Guide">Guia</system:String>
        <system:String x:Key="GuideText">As configuracoes de impressao podem ser definidas por tipo de carimbo. Crie um parametro de tipo "Configuracao de Impressao" em texto na familia de carimbo e preencha com o nome da configuracao desejada. Ao usar tamanho de papel variavel, a ferramenta atribui automaticamente a configuracao compativel com base nesse valor.</system:String>
        <system:String x:Key="KudosToRyan">Baseado no PrintFromIndex, de Ryan McCullough</system:String>
        <system:String x:Key="CopySheetFileNames">Copiar nome(s) de arquivo</system:String>
        <system:String x:Key="SheetNumber">Número</system:String>
        <system:String x:Key="SheetName">Folha</system:String>
        <system:String x:Key="SheetRevision">Revisão</system:String>
        <system:String x:Key="PrintSetting">Configuracao</system:String>
        <system:String x:Key="FileName">Nome do arquivo</system:String>
        <SolidColorBrush x:Key="RevBGColor" Color="#FFE8EDF3"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#FFD8DEE8"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF64748B"/>
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#FFC8D1DD"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="#FF1F3347"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB"/>

        <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF1F2937"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="132"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#FF334155"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,3,8,3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,3,8,3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#FF1F2937"/>
            <Setter Property="Margin" Value="0,0,28,0"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,4,12,4"/>
            <Setter Property="Background" Value="#FFF8FAFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FF1F2937"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="148"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="Exportar folhas"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#FF1D4ED8"/>
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="#FF1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#FF1E40AF"/>
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="#FF1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFE8EDF3"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FFE8EDF3"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF8FAFC"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,0,8,0"/>
            <Setter Property="Background" Value="#FFF1F5F9"/>
            <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
            <Setter Property="Foreground" Value="#FF334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DefaultColumnStyle" TargetType="{x:Type DataGridCell}">
            <Setter Property="ToolTip" Value="{Binding tooltip}"/>
            <Setter Property="ContextMenu" Value="{DynamicResource ItemContextMenu}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding printable}" Value="False">
                    <Setter Property="Foreground" Value="#bdbdbd" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="Default" TargetType="{x:Type DataGridCell}">
            <StackPanel Background="White">
                <GridViewRowPresenter Content="{TemplateBinding Content}"
                                      Columns="{TemplateBinding GridView.ColumnCollection}"/>
            </StackPanel>

        </ControlTemplate>

        <ControlTemplate x:Key="NonPrintableSheet" TargetType='{x:Type DataGridCell}'>
            <StackPanel Background="#f6f6f6">
                <GridViewRowPresenter Content="{TemplateBinding Content}"
                                          Columns="{TemplateBinding GridView.ColumnCollection}"/>
            </StackPanel>
        </ControlTemplate>

        <DataTemplate x:Key="RevisionCell">
            <StackPanel x:Name="revinfo" VerticalAlignment="Center" Orientation="Horizontal">
                <Border Background="{StaticResource RevBGColor}" CornerRadius="3,0,0,3" MinWidth="16" Margin="2,2,0,2" Padding="5,0,5,0">
                    <TextBlock Text="{Binding revision.date}" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <Border Background="{StaticResource RevBGColor}" MinWidth="16" Margin="0,2,0,2" Padding="5,0,5,0" BorderBrush="LightGray" BorderThickness="1,0,1,0">
                    <TextBlock Text="{Binding revision.number}" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Border>
                <Border Background="{StaticResource RevBGColor}" CornerRadius="0,3,3,0" MinWidth="16" Padding="5,0,5,0" Margin="0,2,0,2">
                    <TextBlock Text="{Binding revision.desc}" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding revision.is_set}" Value="False">
                    <Setter TargetName="revinfo" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PrintSettingCell">
            <StackPanel x:Name="psettinginfo" VerticalAlignment="Center" Orientation="Horizontal">
                <Border Background="{StaticResource RevBGColor}" CornerRadius="3" Margin="2,2,0,2" Padding="5,0,5,0">
                    <TextBlock x:Name="psettingname" Text="{Binding print_settings.Name}" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding read_only}" Value="True">
                    <Setter TargetName="psettingname" Property="Foreground" Value="Gray" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style TargetType="{x:Type Hyperlink}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextBlock.TextDecorations" Value="{x:Null}" />
        </Style>

        <Viewbox x:Key="printIcon" Width="24" Height="24">
            <Canvas Width="24" Height="24">
                <Path Data="M18,3H6V7H18M19,12A1,1 0 0,1 18,11A1,1 0 0,1 19,10A1,1 0 0,1 20,11A1,1 0 0,1 19,12M16,19H8V14H16M19,8H5A3,3 0 0,0 2,11V17H6V21H18V17H22V11A3,3 0 0,0 19,8Z"
                      Fill="White"/>
            </Canvas>
        </Viewbox>

        <DataTemplate x:Key="printSettingsItem">
            <WrapPanel>
                <TextBlock x:Name="sizeName" Text="{Binding name}" />
                <Border x:Name="incompatibleMarker" Background="Red"  Height="18" Margin="8,0,0,0" CornerRadius="3">
                    <TextBlock HorizontalAlignment="Left" Padding="5" Text="{DynamicResource IncompatibleWithPrinter}" FontSize="10" Foreground="White" VerticalAlignment="Center" />
                </Border>
            </WrapPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding is_compatible}" Value="True">
                    <Setter TargetName="incompatibleMarker" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="sizeName" Property="Foreground" Value="Black" />
                </DataTrigger>
                <DataTrigger Binding="{Binding is_compatible}" Value="False">
                    <Setter TargetName="incompatibleMarker" Property="Visibility" Value="Visible" />
                    <Setter TargetName="sizeName" Property="Foreground" Value="Gray" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Exportar folhas" FontSize="20" FontWeight="SemiBold" Foreground="#FF0F172A"/>
                <TextBlock Text="Escolha as folhas e os formatos de saída." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button x:Name="print_b" DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Click="print_sheets" Content="Exportar folhas"/>
                <Button DockPanel.Dock="Right" Content="Cancelar" IsCancel="True" Click="cancel_export" Margin="0,0,10,0" MinWidth="90"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="sheet_count_tb" Foreground="#FF334155" FontWeight="SemiBold"/>
                    <TextBlock Text="Use Ctrl ou Shift para selecionar parte da lista." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,12,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Model}" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource SheetIndex}" Style="{StaticResource SectionTitleStyle}" Margin="12,0,0,8"/>

                    <ComboBox x:Name="documents_cb" Grid.Row="2" Grid.Column="0" SelectionChanged="doclist_changed" Style="{StaticResource ModernComboBoxStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock x:Name="docname" Text="{Binding name}" />
                                    <TextBlock x:Name="docname_linked" Visibility="Collapsed">
                                        <Run Text="{DynamicResource LinkedPrefix}"/>
                                        <Run Text="{Binding name}"/>
                                    </TextBlock>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding linked}" Value="True">
                                        <Setter TargetName="docname" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="docname_linked" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox x:Name="schedules_cb" Grid.Row="2" Grid.Column="1" Margin="12,0,0,0" SelectionChanged="sheetlist_changed" Style="{StaticResource ModernComboBoxStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding name}" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Formatos" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                        <CheckBox x:Name="export_pdf" IsChecked="True" Checked="options_changed" Unchecked="options_changed" Content="PDF"/>
                        <CheckBox x:Name="export_dwg" IsChecked="False" Checked="options_changed" Unchecked="options_changed" Content="DWG"/>
                        <CheckBox x:Name="combine_cb" IsChecked="False" Checked="options_changed" Unchecked="options_changed" Content="Combinar em um único PDF"/>
                    </StackPanel>
                    <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="Salvar em" Style="{StaticResource FieldLabelStyle}"/>
                        <Button DockPanel.Dock="Right" Content="Escolher pasta…" Click="choose_output_folder" Margin="8,0,0,0" MinWidth="120"/>
                        <TextBox x:Name="output_folder_tb" IsReadOnly="True" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Pasta de destino">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Text" Value="Escolha a pasta de destino"/>
                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </DockPanel>
                    <Expander Header="Configurações de saída" Margin="0,10,0,0" HorizontalContentAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel x:Name="namingformat_dp" Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource NamingFormat}" Style="{StaticResource FieldLabelStyle}"/>
                            <Button Content="{DynamicResource EditFormats}" DockPanel.Dock="Right" Width="110" Margin="8,0,0,0" Click="edit_formats"/>
                            <ComboBox x:Name="namingformat_cb" FontFamily="Consolas" SelectionChanged="options_changed" Style="{StaticResource ModernComboBoxStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Padding="5,1,5,1">
                                                <TextBlock Text="{Binding name}">
                                                    <TextBlock.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Copiar formato" Click="copy_naming_format"/>
                                                        </ContextMenu>
                                                    </TextBlock.ContextMenu>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <DockPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="{DynamicResource Printer}" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="printers_cb" SelectionChanged="printers_changed" Style="{StaticResource ModernComboBoxStyle}"/>
                        </DockPanel>

                        <DockPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource PageSettings}" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="printsettings_cb" SelectionChanged="sheetlist_changed" ItemTemplate="{StaticResource printSettingsItem}" Style="{StaticResource ModernComboBoxStyle}"/>
                        </DockPanel>

                        <DockPanel x:Name="dwgsettings_dp" Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="{DynamicResource DwgSettings}" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="dwgsettings_cb" Style="{StaticResource ModernComboBoxStyle}"/>
                        </DockPanel>
                    </Grid>
                    </Expander>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock Text="{DynamicResource ListOfSheets}" Style="{StaticResource SectionTitleStyle}" DockPanel.Dock="Left"/>
                    <DockPanel DockPanel.Dock="Right" Width="390">
                        <TextBlock Text="{DynamicResource SheetSearch}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="sheetsearch_tb" Text="" TextChanged="sheet_search_changed"/>
                    </DockPanel>
                </DockPanel>

                <Border x:Name="errormsg_block" Background="#FFDC2626" Padding="10,7" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock x:Name="errormsg_tb" Foreground="White" VerticalAlignment="Center" />
                </Border>

                <Border x:Name="varsizeguide" Padding="10" Background="#FF334155" Margin="0,0,0,8" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Right">
                        <DockPanel x:Name="sheetopts_wp" DockPanel.Dock="Right" IsEnabled="False">
                            <DockPanel DockPanel.Dock="Bottom">
                                <Button DockPanel.Dock="Right" Height="30" Width="155" Margin="10,0,0,0" Content="{DynamicResource SetPrintSettings}" Click="set_sheet_printsettings"/>
                                <Button DockPanel.Dock="Left" Height="30" Width="145" Content="{DynamicResource ResetPrintSettings}" Click="sheetlist_changed"/>
                            </DockPanel>
                            <Grid />
                        </DockPanel>
                        <Expander Header="{DynamicResource Guide}" Foreground="White" Cursor="Help">
                            <TextBlock Margin="5,5,0,0" TextWrapping="Wrap" Foreground="White" Text="{DynamicResource GuideText}"/>
                        </Expander>
                    </DockPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="3">
            <DataGrid x:Name="sheets_lb"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  EnableColumnVirtualization="True"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  SelectionChanged="sheet_selection_changed">
            <DataGrid.Resources>
                <ContextMenu x:Key="ItemContextMenu">
                    <MenuItem  Header="{DynamicResource CopySheetFileNames}" Click="copy_filenames" />
                </ContextMenu>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="{StaticResource SheetNumber}" Binding="{Binding number}" MinWidth="100" Width="100" IsReadOnly="True" CellStyle="{StaticResource DefaultColumnStyle}"/>
                <DataGridTextColumn Header="{StaticResource SheetName}" Binding="{Binding name}" MinWidth="220" Width="2*" IsReadOnly="True" CellStyle="{StaticResource DefaultColumnStyle}"/>
                <DataGridTemplateColumn Header="{StaticResource SheetRevision}" MinWidth="50" Width="1*" IsReadOnly="True"
                                        CellTemplate="{StaticResource RevisionCell}" SortMemberPath="revision_date_sortable" />
                <DataGridTemplateColumn x:Name="psettingcol" Header="{StaticResource PrintSetting}" MinWidth="50" Width="*" IsReadOnly="True" CellTemplate="{StaticResource PrintSettingCell}" Visibility="Collapsed"/>
                <DataGridTextColumn x:Name="pfilename" Header="{StaticResource FileName}" FontFamily="Consolas" Binding="{Binding print_filename}" MinWidth="50" Width="2*" IsReadOnly="True" CellStyle="{StaticResource DefaultColumnStyle}" Visibility="Collapsed"/>
            </DataGrid.Columns>
        </DataGrid>
                <TextBlock x:Name="empty_state_tb" Text="Nenhuma folha encontrada. Ajuste a busca ou o índice de folhas." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
