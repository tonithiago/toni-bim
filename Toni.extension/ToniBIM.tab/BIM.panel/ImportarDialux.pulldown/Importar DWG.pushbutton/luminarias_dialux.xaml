<?xml version="1.0" encoding="utf-8"?>
<!-- Interface legada de referência. O script atual usa os diálogos do pyRevit. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alocação de Luminárias - Dialux para Revit"
        Height="500" Width="450"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" VerticalAlignment="Top" HorizontalAlignment="Stretch">

            <!-- Vínculo CAD -->
            <TextBlock Text="Selecione o Vínculo CAD:" Margin="0,0,0,5" FontWeight="Bold"/>
            <ComboBox x:Name="cadLinkComboBox" Height="25" Width="300" HorizontalAlignment="Left" />

            <!-- Mapeamento de Luminárias -->
            <TextBlock Text="Mapeamento das Luminárias (Layer → Família Revit):" Margin="0,40,0,10" FontWeight="Bold" />

            <!-- Bloco 1 -->
            <TextBlock Text="Layer: LUM 1" Margin="0,5,0,2"/>
            <ComboBox x:Name="familyTypeComboBox1" Height="25" Width="400" HorizontalAlignment="Left"/>

            <!-- Bloco 2 -->
            <TextBlock Text="Layer: LUM 2" Margin="0,10,0,2" />
            <ComboBox x:Name="familyTypeComboBox2" Height="25" Width="400" HorizontalAlignment="Left"/>

            <!-- Bloco 3 -->
            <TextBlock Text="Layer: LUM 3" Margin="0,10,0,2" />
            <ComboBox x:Name="familyTypeComboBox3" Height="25" Width="400" HorizontalAlignment="Left"/>

            <!-- Bloco 4 -->
            <TextBlock Text="Layer: LUM 4" Margin="0,10,0,2" />
            <ComboBox x:Name="familyTypeComboBox4" Height="25" Width="400" HorizontalAlignment="Left"/>

            <!-- Bloco 5 -->
            <TextBlock Text="Layer: LUM 5" Margin="0,10,0,2" />
            <ComboBox x:Name="familyTypeComboBox5" Height="25" Width="400" HorizontalAlignment="Left"/>

            <!-- Botão -->
            <Button x:Name="executeButton"
                    Content="Executar"
                    Height="35"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Width="100" />

            <!-- Rodapé -->
            <TextBlock Grid.Row="12" Text="Versão do Plugin: 2.7"
                       FontSize="10" Foreground="Gray"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
