<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportando NWC"
        Height="260" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFF5F6F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Padding="16"
            Background="#FFFFFFFF"
            BorderBrush="#FFE2E6EA"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Exportando arquivos NWC"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#FF1F2933"/>
                <TextBlock x:Name="statusTextBlock"
                           Margin="0,6,0,0"
                           Text="Preparando exportacao..."
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#FF5A6673"/>
            </StackPanel>

            <ProgressBar x:Name="exportProgressBar"
                         Grid.Row="1"
                         Margin="0,18,0,0"
                         Height="24"
                         Minimum="0"
                         Maximum="100"
                         Value="0"/>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Progresso" Foreground="#FF7A8490"/>
                    <TextBlock x:Name="percentTextBlock"
                               Text="0%"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#FF1F2933"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Tempo Decorrido" Foreground="#FF7A8490"/>
                    <TextBlock x:Name="elapsedTimeTextBlock"
                               Text="0 min 0.0 s"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FF1F2933"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tempo Estimado" Foreground="#FF7A8490"/>
                    <TextBlock x:Name="estimatedTimeTextBlock"
                               Text="Calculando..."
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FF1F2933"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3"
                       Margin="0,14,0,0"
                       Text="O cancelamento acontece assim que o arquivo atual terminar."
                       Foreground="#FF7A8490"
                       TextWrapping="Wrap"/>

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="cancelButton"
                        Grid.Column="1"
                        MinWidth="104"
                        Content="Cancelar"/>
            </Grid>
        </Grid>
    </Border>
</Window>
